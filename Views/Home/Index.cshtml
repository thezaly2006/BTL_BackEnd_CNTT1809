@{
    ViewData["Title"] = "Trang chủ";
}

<div class="text-center mt-5">
    <h1 class="display-4"><i class="fas fa-dumbbell"></i> Gym Management System</h1>
    <p class="lead">Hệ thống quản lý phòng Gym & Personal Training</p>
    <hr class="my-4">
    <p>Quản lý hội viên, lịch tập và check-in một cách chuyên nghiệp</p>
    
    <div class="mt-4">
        <a class="btn btn-primary btn-lg m-2" href="/Dashboard">
            <i class="fas fa-tachometer-alt"></i> Dashboard
        </a>
        <a class="btn btn-success btn-lg m-2" href="/Members">
            <i class="fas fa-users"></i> Quản lý hội viên
        </a>
        <a class="btn btn-info btn-lg m-2" href="/PTSchedules">
            <i class="fas fa-calendar-alt"></i> Lịch PT
        </a>
    </div>
</div>

<div class="row mt-5">
    <div class="col-md-4">
        <div class="card">
            <div class="card-body text-center">
                <i class="fas fa-users fa-4x text-primary mb-3"></i>
                <h5 class="card-title">Quản lý Hội viên</h5>
                <p class="card-text">Theo dõi thông tin, gói tập và hạn thẻ của hội viên</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body text-center">
                <i class="fas fa-user-friends fa-4x text-success mb-3"></i>
                <h5 class="card-title">Huấn luyện viên</h5>
                <p class="card-text">Quản lý PT và xếp lịch dạy 1-1</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body text-center">
                <i class="fas fa-clipboard-check fa-4x text-info mb-3"></i>
                <h5 class="card-title">Check-in/Check-out</h5>
                <p class="card-text">Ghi nhận lịch sử ra vào phòng tập</p>
            </div>
        </div>
    </div>
</div>
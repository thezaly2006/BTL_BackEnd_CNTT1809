@model GymManagement.Controllers.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="container mt-4">
    <h2><i class="fas fa-tachometer-alt"></i> Bảng điều khiển</h2>
    
    <div class="row mt-4">
        <!-- Tổng số hội viên -->
        <div class="col-md-3 mb-3">
            <div class="card bg-primary text-white h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title">Tổng hội viên</h6>
                            <h2>@Model.TotalMembers</h2>
                        </div>
                        <i class="fas fa-users fa-3x opacity-50"></i>
                    </div>
                </div>
                <div class="card-footer d-flex">
                    <small class="text-white">
                        <span class="text-success"><i class="fas fa-check"></i> @Model.ActiveMembers</span> đang hoạt động
                    </small>
                </div>
            </div>
        </div>

        <!-- Huấn luyện viên -->
        <div class="col-md-3 mb-3">
            <div class="card bg-success text-white h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title">PT</h6>
                            <h2>@Model.TotalPTs</h2>
                        </div>
                        <i class="fas fa-user-friends fa-3x opacity-50"></i>
                    </div>
                </div>
                <div class="card-footer d-flex">
                    <small class="text-white">
                        <span class="text-light">@Model.AvailablePTs</span> sẵn sàng
                    </small>
                </div>
            </div>
        </div>

        <!-- Lịch hôm nay -->
        <div class="col-md-3 mb-3">
            <div class="card bg-info text-white h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title">Lịch PT hôm nay</h6>
                            <h2>@Model.TodaySchedules</h2>
                        </div>
                        <i class="fas fa-calendar-day fa-3x opacity-50"></i>
                    </div>
                </div>
                <div class="card-footer d-flex">
                    <small class="text-white">
                        <span class="text-light">@Model.TodayCheckIns</span> check-in
                    </small>
                </div>
            </div>
        </div>

        <!-- Cảnh báo -->
        <div class="col-md-3 mb-3">
            <div class="card bg-warning text-white h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title">Sắp hết hạn</h6>
                            <h2>@Model.ExpiringSoon</h2>
                        </div>
                        <i class="fas fa-exclamation-triangle fa-3x opacity-50"></i>
                    </div>
                </div>
                <div class="card-footer d-flex">
                    <small class="text-white">
                        Trong 7 ngày tới
                    </small>
                </div>
            </div>
        </div>
    </div>

    <!-- Thao tác nhanh -->
    <div class="row mt-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0"><i class="fas fa-bolt"></i> Thao tác nhanh</h5>
                </div>
                <div class="card-body">
                    <a href="/Members/Create" class="btn btn-primary m-1">
                        <i class="fas fa-user-plus"></i> Thêm hội viên
                    </a>
                    <a href="/MembershipTypes/Create" class="btn btn-success m-1">
                        <i class="fas fa-plus-circle"></i> Thêm gói tập
                    </a>
                    <a href="/PersonalTrainers/Create" class="btn btn-info m-1">
                        <i class="fas fa-user-plus"></i> Thêm PT
                    </a>
                    <a href="/PTSchedules/Create" class="btn btn-warning m-1">
                        <i class="fas fa-calendar-plus"></i> Đặt lịch PT
                    </a>
                    <a href="/CheckInLogs" class="btn btn-secondary m-1">
                        <i class="fas fa-clipboard-list"></i> Lịch sử check-in
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Đang trong phòng -->
    <div class="row mt-4">
        <div class="col-12">
            <div class="card bg-danger text-white">
                <div class="card-body text-center">
                    <h3><i class="fas fa-dumbbell"></i> Đang tập trong phòng: @Model.CurrentCheckedIn người</h3>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .opacity-50 {
        opacity: 0.3;
    }
</style>